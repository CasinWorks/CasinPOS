# Copy values from your Supabase project settings → API.
# Pass to Flutter via:
#   flutter run --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=... \
#     --dart-define=APP_URL=https://casin-pos-black.vercel.app

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
APP_URL=https://casin-pos-black.vercel.app

# RevenueCat public SDK keys (iOS/Android only — not used on web)
REVENUECAT_IOS_API_KEY=appl_xxx
REVENUECAT_ANDROID_API_KEY=goog_xxx
