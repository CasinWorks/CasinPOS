# Supabase (required for CasinPOS)
# Copy from Supabase → Project Settings → API
# Local Flutter:
#   flutter run -d chrome \
#     --dart-define=SUPABASE_URL=... \
#     --dart-define=SUPABASE_ANON_KEY=... \
#     --dart-define=APP_URL=https://casin-pos-black.vercel.app
# Vercel: set the same names as Project Environment Variables (Production + Preview).

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional — invite share links (default production URL if unset on mobile)
APP_URL=https://casin-pos-black.vercel.app

# Invite emails (Supabase Edge Function secrets — not Flutter env):
#   RESEND_API_KEY=re_xxxx
#   RESEND_FROM_EMAIL=CasinPOS <invites@yourdomain.com>
#   PUBLIC_APP_URL=https://casin-pos-black.vercel.app
